{
  "name": "links-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev --port 8787 --local --local-upstream links-api.toolproof.workers.dev",
    "deploy": "wrangler deploy",
    "db:init": "wrangler d1 execute links-db --remote --file=schema.sql",
    "db:init:local": "wrangler d1 execute links-db --local --file=schema.sql"
  },
  "devDependencies": {
    "wrangler": "^4.86.0"
  }
}
